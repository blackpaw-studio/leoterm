{
  "id": "studio.blackpaw.usage",
  "name": "Account Usage",
  "version": "0.1.0",
  "apiVersion": 2,
  "main": "dist/main.js",
  "permissions": {
    "network": ["api.anthropic.com", "chatgpt.com"],
    "credentials": ["claude-code", "codex"],
    "secrets": true
  },
  "contributes": {
    "sidebarSections": [{ "id": "usage", "title": "Usage" }],
    "commands": [
      { "id": "show", "title": "Show Account Usage", "sfSymbol": "gauge" },
      { "id": "add-claude", "title": "Add Claude Account…", "sfSymbol": "plus.circle" },
      { "id": "add-codex", "title": "Add Codex Account…", "sfSymbol": "plus.circle" },
      { "id": "refresh", "title": "Refresh Usage", "sfSymbol": "arrow.clockwise" }
    ]
  }
}
